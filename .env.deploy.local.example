# NexaTech deployment — copy to .env.deploy.local and fill real values.
# Never commit .env.deploy.local or .secrets/

# --- Git / build ---
NEXATECH_IMAGE_TAG=
NEXATECH_BUILD_ID=

# --- Kubernetes access (REQUIRED for deploy) ---
# Absolute path to kubeconfig, OR leave empty if kubectl already uses default context
KUBECONFIG=
# SSH alternative (optional if kubeconfig provided)
K8S_SSH_HOST=
K8S_SSH_USER=
K8S_SSH_KEY_PATH=

# --- Node topology ---
# Comma-separated application node names (nexatech.io/role=app)
K8S_APP_NODE_NAMES=
# Dedicated Kong node name
KONG_NODE_NAME=
# Or Kong node IP if name unknown
KONG_NODE_IP=

# --- Container registry (REQUIRED for push) ---
CONTAINER_REGISTRY_URL=
CONTAINER_REGISTRY_USERNAME=
CONTAINER_REGISTRY_TOKEN=
CONTAINER_REGISTRY_NAMESPACE=nexatech

# --- PostgreSQL server (REQUIRED for clean deploy DB) ---
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_ADMIN_USER=
POSTGRES_ADMIN_PASSWORD=
POSTGRES_SSLMODE=prefer

# Destructive clean confirmation (must be exact string)
NEXATECH_CONFIRM_DEPLOY_DATABASE_CLEAN=

# --- MetalLB (REQUIRED if cluster has no LoadBalancer) ---
METALLB_ADDRESS_POOL=
# Example: 192.168.1.200-192.168.1.210

# --- Public URLs (LAN/IP first; domain later via values only) ---
PUBLIC_BASE_URL=
API_PUBLIC_URL=
ADMIN_PUBLIC_URL=
SWAGGER_PUBLIC_URL=
SECURITY_GUIDE_PUBLIC_URL=
MAILPIT_PUBLIC_URL=

# --- Optional production SMTP (Gmail) — do not block staging ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=
SMTP_APP_PASSWORD=
SMTP_FROM_NAME=NexaTech
SMTP_FROM_EMAIL=

# --- Required account seed (operator-defined; never commit real value) ---
REQUIRED_SEED_PASSWORD=
NEXATECH_ALLOW_REQUIRED_SEED=YES

# --- Staging Mailpit ---
MAILPIT_ENABLED=true

# --- Security Guide portal ---
SECURITY_GUIDE_USERNAME=nexatech-docs
# Password hash written to .secrets/security-guide-credentials.txt by seed job

# --- Helm ---
HELM_NAMESPACE=nexatech
HELM_RELEASE_NAME=nexatech
HELM_KONG_RELEASE_NAME=nexatech-kong
HELM_ENVIRONMENT=staging
