# Identity service
IDENTITY_DATABASE_URL=postgresql://nexatech_identity:changeme@localhost:5432/nexatech_identity
CUSTOMER_DATABASE_URL=postgresql://nexatech_customer:changeme@localhost:5432/nexatech_customer
CATALOG_DATABASE_URL=postgresql://nexatech_catalog:changeme@localhost:5432/nexatech_catalog
MEDIA_DATABASE_URL=postgresql://nexatech_media:changeme@localhost:5432/nexatech_media
INVENTORY_DATABASE_URL=postgresql://nexatech_inventory:changeme@localhost:5432/nexatech_inventory
CART_DATABASE_URL=postgresql://nexatech_cart:changeme@localhost:5432/nexatech_cart
ORDER_DATABASE_URL=postgresql://nexatech_order:changeme@localhost:5432/nexatech_order
PAYMENT_DATABASE_URL=postgresql://nexatech_payment:changeme@localhost:5432/nexatech_payment
SHIPPING_DATABASE_URL=postgresql://nexatech_shipping:changeme@localhost:5432/nexatech_shipping
REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://guest:guest@localhost:5672
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
IDENTITY_PORT=3001
CUSTOMER_PORT=3002
CATALOG_PORT=3003
MEDIA_PORT=3004
INVENTORY_PORT=3005
CART_PORT=3006
ORDER_PORT=3007
PAYMENT_PORT=3008
SHIPPING_PORT=3009
INVENTORY_LOW_STOCK_THRESHOLD=5
CATALOG_SERVICE_URL=http://localhost:3003
INVENTORY_SERVICE_URL=http://localhost:3005
CART_SERVICE_URL=http://localhost:3006
ORDER_SERVICE_URL=http://localhost:3007
CUSTOMER_SERVICE_URL=http://localhost:3002
PAYMENT_SERVICE_URL=http://localhost:3008
SHIPPING_SERVICE_URL=http://localhost:3009
PAYMENT_PUBLIC_BASE_URL=http://localhost:3008
PAYMENT_RETURN_URL=http://localhost:3000/checkout/payment/return
PAYMENT_IPN_URL=http://localhost:3008/api/v1/vnpay/ipn
MOCK_PAYMENT_ENABLED=true
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:3008/api/v1/vnpay/return
VNPAY_IPN_URL=http://localhost:3008/api/v1/vnpay/ipn

# Shipping (M9)
MOCK_SHIPPING_ENABLED=true
SHIPPING_PROVIDER=MOCK
SHIPPING_PUBLIC_BASE_URL=http://localhost:3009
SHIPPING_WEBHOOK_URL=http://localhost:3009/api/v1/shipping/webhooks/MOCK
SHIPPING_WEBHOOK_SECRET=change-me-shipping-webhook-secret
GHN_BASE_URL=
GHN_TOKEN=
GHN_SHOP_ID=

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
NODE_ENV=development

# MinIO (local only — không dùng credential production)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_PRODUCT=product-media
MINIO_REGION=us-east-1
MEDIA_MAX_UPLOAD_BYTES=20971520
