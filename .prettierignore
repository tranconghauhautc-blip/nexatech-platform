# Add files here to ignore them from prettier formatting
/dist
/coverage
/.nx/cache
/.nx/workspace-data

# Helm Go templates are not valid YAML for Prettier
/deploy/helm/**/templates/**

# Local tooling
/.tools/**

# Lockfile has its own formatter (pnpm); Prettier reformatting it (flow -> block
# YAML style) creates massive noisy diffs with no functional benefit.
/pnpm-lock.yaml

# Generated OpenAPI artifacts — formatted by scripts/openapi (custom YAML dumper)
/openapi/**/*.json
/openapi/**/*.yaml
/openapi/**/*.yml
