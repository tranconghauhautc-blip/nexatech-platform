generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("INVENTORY_DATABASE_URL")
}

enum LocationType {
  warehouse
  store
}

enum ReservationStatus {
  ACTIVE
  RELEASED
  COMMITTED
  EXPIRED
}

enum TransferStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum MovementType {
  IN
  OUT
  RESERVE
  RELEASE
  COMMIT
  RETURN
  TRANSFER_OUT
  TRANSFER_IN
  ADJUST
}

model Warehouse {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  address   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stores Store[]
}

model Store {
  id          String     @id @default(uuid())
  code        String     @unique
  name        String
  warehouseId String?
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  address     String?
  city        String?
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model StockItem {
  id                String       @id @default(uuid())
  skuCode           String
  locationType      LocationType
  locationId        String
  onHand            Int          @default(0)
  reserved          Int          @default(0)
  version           Int          @default(0)
  lowStockThreshold Int          @default(5)
  updatedAt         DateTime     @updatedAt

  @@unique([skuCode, locationType, locationId])
  @@index([skuCode])
}

model Reservation {
  id             String            @id @default(uuid())
  idempotencyKey String            @unique
  orderId        String?
  status         ReservationStatus @default(ACTIVE)
  expiresAt      DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  lines ReservationLine[]
}

model ReservationLine {
  id            String       @id @default(uuid())
  reservationId String
  reservation   Reservation  @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  skuCode       String
  locationType  LocationType
  locationId    String
  quantity      Int

  @@index([reservationId])
}

model StockMovement {
  id               String       @id @default(uuid())
  skuCode          String
  locationType     LocationType
  locationId       String
  type             MovementType
  quantity         Int
  balanceOnHand    Int
  balanceReserved  Int
  referenceType    String?
  referenceId      String?
  actorId          String?
  note             String?
  createdAt        DateTime     @default(now())

  @@index([skuCode, createdAt])
}

model Transfer {
  id             String         @id @default(uuid())
  idempotencyKey String         @unique
  skuCode        String
  quantity       Int
  fromLocationType LocationType
  fromLocationId String
  toLocationType LocationType
  toLocationId   String
  status         TransferStatus @default(PENDING)
  note           String?
  createdAt      DateTime       @default(now())
  completedAt    DateTime?
}

model IdempotencyRecord {
  key          String   @id
  operation    String
  responseJson Json
  createdAt    DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  actorId   String
  details   Json?
  createdAt DateTime @default(now())
}
