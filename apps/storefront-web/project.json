{
  "name": "storefront-web",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/storefront-web",
  "projectType": "application",
  "tags": ["scope:frontend", "type:app"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/.next"],
      "dependsOn": ["^build"],
      "options": {
        "cwd": "apps/storefront-web",
        "tty": false,
        "command": "cross-env NODE_ENV=production next build"
      },
      "configurations": {
        "production": {}
      }
    }
  }
}
