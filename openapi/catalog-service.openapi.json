{
  "components": {
    "schemas": {
      "ErrorEnvelope": {
        "type": "object",
        "required": [
          "errorCode",
          "message",
          "details",
          "traceId",
          "timestamp"
        ],
        "properties": {
          "errorCode": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "details": {
            "type": "object",
            "additionalProperties": true
          },
          "traceId": {
            "type": "string",
            "format": "uuid"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "PaginationMeta": {
        "type": "object",
        "required": [
          "page",
          "pageSize",
          "totalItems",
          "totalPages"
        ],
        "properties": {
          "page": {
            "type": "integer"
          },
          "pageSize": {
            "type": "integer"
          },
          "totalItems": {
            "type": "integer"
          },
          "totalPages": {
            "type": "integer"
          }
        }
      }
    },
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "JWT access token from identity POST /api/v1/auth/login. Never commit real tokens."
      },
      "idempotencyKey": {
        "type": "apiKey",
        "in": "header",
        "name": "Idempotency-Key"
      },
      "requestId": {
        "type": "apiKey",
        "in": "header",
        "name": "x-request-id"
      },
      "traceId": {
        "type": "apiKey",
        "in": "header",
        "name": "x-trace-id"
      },
      "userId": {
        "type": "apiKey",
        "in": "header",
        "name": "x-user-id"
      },
      "userRoles": {
        "type": "apiKey",
        "in": "header",
        "name": "x-user-roles"
      }
    }
  },
