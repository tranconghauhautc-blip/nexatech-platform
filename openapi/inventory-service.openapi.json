      "idempotencyKey": {
        "type": "apiKey",
        "in": "header",
        "name": "Idempotency-Key"
      },
      "requestId": {
        "type": "apiKey",
        "in": "header",
        "name": "x-request-id"
      },
      "traceId": {
        "type": "apiKey",
        "in": "header",
        "name": "x-trace-id"
      },
      "userId": {
        "type": "apiKey",
        "in": "header",
        "name": "x-user-id"
      },
      "userRoles": {
        "type": "apiKey",
        "in": "header",
        "name": "x-user-roles"
      }
    }
  },
