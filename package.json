    "ioredis": "5.6.0",
    "jsonwebtoken": "9.0.2",
    "minio": "^8.0.7",
    "next": "15.2.4",
    "nodemailer": "^9.0.3",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "reflect-metadata": "0.2.2",
