{
  "name": "@nexatech/source",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "scripts": {
    "format": "cross-env NX_SKIP_NATIVE_FILE_CACHE=true NX_DAEMON=false nx format:write",
    "format:check": "cross-env NX_SKIP_NATIVE_FILE_CACHE=true NX_DAEMON=false nx format:check",
    "lint": "cross-env NX_SKIP_NATIVE_FILE_CACHE=true NX_DAEMON=false nx run-many -t lint --all",
    "test": "cross-env NX_SKIP_NATIVE_FILE_CACHE=true NX_DAEMON=false nx run-many -t test --all",
    "build": "node scripts/clean-frontend-next.cjs && cross-env NODE_ENV=production NX_SKIP_NATIVE_FILE_CACHE=true NX_DAEMON=false nx run-many -t build --all",
    "build:storefront": "node scripts/clean-frontend-next.cjs && cross-env NODE_ENV=production NX_SKIP_NATIVE_FILE_CACHE=true NX_DAEMON=false nx run storefront-web:build --configuration=production",
    "build:admin": "node scripts/clean-frontend-next.cjs && cross-env NODE_ENV=production NX_SKIP_NATIVE_FILE_CACHE=true NX_DAEMON=false nx run admin-web:build --configuration=production",
    "test:no-next-document": "node --test tests/build/no-next-document-import.test.cjs tests/build/frontend-build-node-env-production.test.cjs",
    "typecheck": "cross-env NX_SKIP_NATIVE_FILE_CACHE=true NX_DAEMON=false nx run-many -t typecheck --all",
    "graph": "cross-env NX_SKIP_NATIVE_FILE_CACHE=true NX_DAEMON=false nx graph",
    "e2e": "playwright test",
    "e2e:storefront": "playwright test --project=storefront-chromium",
    "e2e:admin": "playwright test --project=admin-chromium",
    "seed:catalog": "node scripts/seed-catalog.cjs",
    "seed:accounts": "node scripts/seed-accounts.cjs",
    "seed:customers": "node scripts/seed-customers.cjs",
    "test:seed-accounts": "node --test tests/seed/seed-accounts.test.cjs",
    "test:seed-customers": "node --test tests/seed/seed-customers.test.cjs",
    "security:test:secure": "node tests/security/run.cjs secure",
    "security:test:lab": "cross-env SECURITY_LAB_ACK=YES node tests/security/run.cjs lab",
    "security:smoke": "cross-env SECURITY_LAB_ACK=YES node tests/security/smoke.cjs",
    "security:validate": "node tests/security/validate.cjs",
    "openapi:generate": "node scripts/openapi/generate.cjs",
    "openapi:combine": "node scripts/openapi/combine.cjs",
    "openapi:validate": "node scripts/openapi/validate.cjs",
    "openapi:diff": "node scripts/openapi/diff.cjs",
    "openapi:check": "node scripts/openapi/check.cjs",
    "helm:lint": "node scripts/deployment/helm-lint.cjs",
    "docker:build:all": "pwsh -File scripts/images/build-all.ps1",
    "e2e:setup": "pwsh -File scripts/e2e/setup.ps1",
    "e2e:seed": "pwsh -File scripts/e2e/seed.ps1",
    "e2e:run": "pwsh -File scripts/e2e/run.ps1",
    "e2e:teardown": "pwsh -File scripts/e2e/teardown.ps1",
    "seed:inventory": "node scripts/seed-inventory.cjs",
    "seed:pickup-stores": "node scripts/seed-pickup-stores.cjs",
    "test:seed-pickup-stores": "node --test tests/seed/seed-pickup-stores.test.cjs",
    "security-guide:setup": "node scripts/security-guide/setup.cjs",
    "security-guide:rotate-credentials": "node scripts/security-guide/rotate-credentials.cjs",
    "security-guide:serve": "node apps/security-guide-portal/src/main.cjs",
    "security-guide:test": "node scripts/security-guide/test.cjs",
    "security-guide:expand-scenarios": "node scripts/security-guide/expand-scenarios.cjs",
    "import:product-images": "node scripts/import-product-images.cjs",
    "generate:product-images": "node scripts/generate-placeholder-product-images.cjs",
    "checkout:smoke": "node scripts/checkout-smoke.cjs",
    "lab:smoke": "node scripts/local-lab-smoke.cjs",
    "lab:reset:minimal": "node scripts/lab-reset-minimal.cjs",
    "test:lab-reset-minimal": "node --test tests/lab/lab-reset-minimal.test.cjs",
    "address-data:import": "node scripts/address-data/import.cjs",
    "address-data:validate": "node scripts/address-data/validate.cjs",
    "address-data:generate": "node scripts/address-data/generate.cjs",
    "media:audit": "node scripts/media-audit.cjs",
    "media:e2e": "node scripts/media-e2e-smoke.cjs",
    "media:import-products": "node scripts/import-product-images.cjs"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.34.5",
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
