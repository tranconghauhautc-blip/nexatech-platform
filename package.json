{
  "name": "@nexatech/source",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "scripts": {
    "format": "cross-env NX_SKIP_NATIVE_FILE_CACHE=true NX_DAEMON=false nx format:write",
    "format:check": "cross-env NX_SKIP_NATIVE_FILE_CACHE=true NX_DAEMON=false nx format:check",
    "lint": "cross-env NX_SKIP_NATIVE_FILE_CACHE=true NX_DAEMON=false nx run-many -t lint --all",
    "test": "cross-env NX_SKIP_NATIVE_FILE_CACHE=true NX_DAEMON=false nx run-many -t test --all",
    "build": "cross-env NX_SKIP_NATIVE_FILE_CACHE=true NX_DAEMON=false nx run-many -t build --all",
    "typecheck": "cross-env NX_SKIP_NATIVE_FILE_CACHE=true NX_DAEMON=false nx run-many -t typecheck --all",
    "graph": "cross-env NX_SKIP_NATIVE_FILE_CACHE=true NX_DAEMON=false nx graph",
    "e2e": "playwright test",
    "e2e:storefront": "playwright test --project=storefront-chromium",
    "e2e:admin": "playwright test --project=admin-chromium",
    "seed:catalog": "node scripts/seed-catalog.cjs",
    "security:test:secure": "node tests/security/run.cjs secure",
    "security:test:lab": "cross-env SECURITY_LAB_ACK=YES node tests/security/run.cjs lab",
    "security:smoke": "cross-env SECURITY_LAB_ACK=YES node tests/security/smoke.cjs",
    "security:validate": "node tests/security/validate.cjs"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.34.5",
