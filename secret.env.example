# VulnCart lab secrets — copy to secret.env and fill in.
# cp secret.env.example secret.env

# Required
POSTGRES_PASSWORD=change-me-strong-password
JWT_SECRET=change-me-jwt-secret-min-32-chars!!
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin123!

# Optional — if empty, Helm builds:
# postgresql://vulncart_app:${POSTGRES_PASSWORD}@vulncart-postgres:5432/vulncart
# DATABASE_URL=

# Optional image overrides (repo:tag)
# BACKEND_IMAGE=ghcr.io/you/vulncart-backend-api:1.0.0
# MIGRATE_IMAGE=ghcr.io/you/vulncart-backend-api-migrate:1.0.0
# STOREFRONT_IMAGE=ghcr.io/you/vulncart-storefront:1.0.0
# ADMIN_IMAGE=ghcr.io/you/vulncart-admin:1.0.0
# GUIDE_IMAGE=ghcr.io/you/vulncart-guide:1.0.0
